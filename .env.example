# Sakay settings. Copy this file to .env.local and fill in the values.
# .env.local is gitignored, so your keys never end up on GitHub.

# Supabase dashboard -> your project -> Project Settings -> Data API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_)
# Older projects: the "anon public" key also works here. NEVER use the secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The public address of the site, used for share links, QR codes and email links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app (or your domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Time zone for every date/time shown in the app (terminal hours, advisories).
NEXT_PUBLIC_TIME_ZONE=Asia/Manila
